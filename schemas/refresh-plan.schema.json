{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-llm-vram-atlas.local/schemas/refresh-plan.schema.json",
  "title": "AtlasRefreshPlan",
  "description": "Dry-run refresh plan: proposed operations with expected fingerprints. Specification version 0.5.0 (Phase 5, pre-1.0).",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_id", "plan_version", "catalog_version", "created_at", "operations"],
  "properties": {
    "plan_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,120}$" },
    "plan_version": { "type": "string", "pattern": "^0\\.[0-9]+\\.[0-9]+$" },
    "catalog_version": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "base_revision": { "type": ["string", "null"] },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "operation", "reason", "risk_severity", "review_state"],
        "properties": {
          "target": { "type": "string", "minLength": 1 },
          "operation": { "type": "string", "enum": ["add_model", "update_model", "mark_unavailable", "mark_restored", "add_artifact", "mark_artifact_removed", "append_change_events", "advance_checkpoint"] },
          "reason": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "risk_severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "informational"] },
          "review_state": { "type": "string", "enum": ["safe_auto_apply", "review_required", "blocked", "informational_only"] },
          "expected_old_fingerprint": { "type": ["string", "null"] },
          "expected_new_fingerprint": { "type": ["string", "null"] }
        }
      }
    }
  }
}
