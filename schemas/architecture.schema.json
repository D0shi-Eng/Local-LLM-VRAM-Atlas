{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-llm-vram-atlas.local/schemas/architecture.schema.json",
  "title": "AtlasArchitectureRecord",
  "description": "Canonical architecture facts resolved from bounded public metadata with per-field provenance and immutable revision. Unknown stays null, never zero; calculated values are marked. Specification version 0.3.0 (Phase 3).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "architecture_family",
    "requested_revision",
    "resolution_status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.[0-9]+\\.[0-9]+$"
    },
    "architecture_family": { "type": "string", "minLength": 1 },
    "model_type": { "type": ["string", "null"] },
    "architectures": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "hidden_size": { "type": ["integer", "null"], "minimum": 1 },
    "intermediate_size": { "type": ["integer", "null"], "minimum": 1 },
    "num_hidden_layers": { "type": ["integer", "null"], "minimum": 1 },
    "num_attention_heads": { "type": ["integer", "null"], "minimum": 1 },
    "num_key_value_heads": { "type": ["integer", "null"], "minimum": 1 },
    "head_dim": { "type": ["integer", "null"], "minimum": 1 },
    "head_dim_source": { "type": ["string", "null"], "enum": ["explicit", "calculated", null] },
    "vocab_size": { "type": ["integer", "null"], "minimum": 1 },
    "max_position_embeddings": { "type": ["integer", "null"], "minimum": 1 },
    "sliding_window": { "type": ["integer", "null"], "minimum": 1 },
    "attention_pattern": { "type": ["string", "null"] },
    "attention_type": { "type": ["string", "null"] },
    "layer_types": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "is_encoder_decoder": { "type": ["boolean", "null"] },
    "tie_word_embeddings": { "type": ["boolean", "null"] },
    "num_experts": { "type": ["integer", "null"], "minimum": 1 },
    "num_experts_per_token": { "type": ["integer", "null"], "minimum": 1 },
    "num_shared_experts": { "type": ["integer", "null"], "minimum": 0 },
    "moe_intermediate_size": { "type": ["integer", "null"], "minimum": 1 },
    "moe_layer_pattern": { "type": ["string", "null"] },
    "state_size": { "type": ["integer", "null"], "minimum": 1 },
    "conv_kernel": { "type": ["integer", "null"], "minimum": 1 },
    "expand_factor": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "ssm_layer_pattern": { "type": ["string", "null"] },
    "mla_info": { "type": ["string", "null"] },
    "custom_remote_architecture": { "type": "boolean" },
    "requested_revision": { "type": ["string", "null"] },
    "resolved_revision": { "type": ["string", "null"] },
    "retrieved_at": { "type": ["string", "null"], "format": "date-time" },
    "conflict_detected": { "type": "boolean" },
    "conflict_detail": { "type": ["string", "null"] },
    "resolution_status": {
      "type": "string",
      "enum": ["resolved", "partial", "unsupported", "insufficient_evidence"]
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
