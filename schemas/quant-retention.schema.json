{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-llm-vram-atlas.local/schemas/quant-retention.schema.json",
  "title": "AtlasQuantRetention",
  "description": "Quantization retention comparison for one base release and one quantized artifact. Retention is only computed when both scores come from materially comparable settings; otherwise the state stays explicit (partially_comparable / insufficient_evidence / unknown). A base-model score is never assigned to a quantized artifact. Specification version 0.6.0 (pre-1.0).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "retention_id",
    "base_release",
    "quantized_artifact",
    "quantization",
    "benchmark_id",
    "retention_status",
    "evidence_ids"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.[0-9]+\\.[0-9]+$"
    },
    "retention_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,120}$"
    },
    "base_release": {
      "type": "string",
      "minLength": 1
    },
    "quantized_artifact": {
      "type": "string",
      "minLength": 1
    },
    "quantization": {
      "type": [
        "string",
        "null"
      ]
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "base_score": {
      "type": [
        "number",
        "null"
      ]
    },
    "quant_score": {
      "type": [
        "number",
        "null"
      ]
    },
    "metric": {
      "type": [
        "string",
        "null"
      ]
    },
    "metric_direction": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "higher_is_better",
        "lower_is_better",
        null
      ]
    },
    "absolute_delta": {
      "type": [
        "number",
        "null"
      ],
      "description": "quant - base in raw metric units; null whenever the comparison is invalid."
    },
    "relative_delta": {
      "type": [
        "number",
        "null"
      ],
      "description": "Signed fraction relative to the base score; null for lower-is-better metrics and invalid comparisons."
    },
    "evaluation_settings_match": {
      "type": "boolean",
      "description": "True only when benchmark version, prompting, reasoning mode and harness are materially comparable."
    },
    "retention_status": {
      "type": "string",
      "enum": [
        "directly_measured",
        "independently_measured",
        "publisher_measured",
        "partially_comparable",
        "insufficient_evidence",
        "unknown"
      ]
    },
    "source": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_quality": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "independent_multi_source",
        "independent_single_source",
        "verified_single_source",
        "publisher_only",
        "community_only",
        "insufficient",
        "unknown",
        null
      ]
    },
    "verification_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "unknown",
        "unverified",
        "estimated",
        "publisher_claim",
        "quantizer_claim",
        "independently_verified",
        "atlas_verified",
        null
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "publisher_claim": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "claim_text": {
          "type": "string",
          "minLength": 1
        },
        "claim_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "claim_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      },
      "description": "Verbatim retention claim; stays publisher_claim unless independently reproduced."
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    }
  }
}
